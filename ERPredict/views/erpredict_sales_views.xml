<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="erpredict_sales_action" model="ir.actions.act_window">
        <field name="name">Sales</field>
        <field name="res_model">erpredict.sales</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="erpredict_sales_view_list" model="ir.ui.view">
        <field name="name">erpredict.sales.list</field>
        <field name="model">erpredict.sales</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="erpredict_sales_view_form" model="ir.ui.view">
        <field name="name">erpredict.sales.form</field>
        <field name="model">erpredict.sales</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="name"/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
